APP_NAME="IFGF Taipei-Zhongli"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL. Four environments, each with its own database AND its
# own role (STANDARDS.md §1). A role owns exactly one database and is not a
# superuser, so a development or staging credential cannot open production.
#
#   Environment   APP_ENV      DB_DATABASE        Runs on              Holds
#   test          testing      ifgf_app_test      developer machine    nothing — rebuilt by every test run
#   development   local        ifgf_app           developer machine    factory and seeder data
#   staging       staging      ifgf_app_staging   the server           seeded demo data
#   production    production   ifgf_app_prod      the server           real members
#
# The test database is named in phpunit.xml, not here; the suite refuses to run
# unless the name ends in _test. In production, migrate:fresh and db:wipe are
# prohibited. Production data is never copied into another environment.
#
# Host, port, role and password belong to the MACHINE, not to this checkout:
# put them in ~/.ifgf/postgres.env (read by bootstrap/global-env.php before
# this file) as IFGF_PG_HOST, IFGF_PG_PORT, IFGF_PG_USERNAME, IFGF_PG_PASSWORD.
# The DB_* lines below are only a fallback for a machine without that file.
# Never commit a password.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_DATABASE=
# DB_HOST=
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Outside production the mailer is always `log`: no real mail is sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

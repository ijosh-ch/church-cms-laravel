APP_NAME=ChurchCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Installation & Single Church Configuration
CHURCH_INSTALLED=false
PRIMARY_CHURCH_ID=

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=churchcms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

REMINDER=mail

MAIL_FROM_ADDRESS=noreply@example.com

MAIL_STATUS=on

SMS_GATEWAY=MSG91
REMINDER_API_KEY=
REMINDER_SENDER_ID=
REMINDER_ROUTE_NO=4

SMS_STATUS=off

FCM_SERVER_KEY=

FCM_SENDER_ID=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Application timezone. Read by config/app.php:71 as env('TIMEZONE'). Owner decision
# 2026-08-15: UTC at rest, per PRD.md L859/L877/L909/L1502 and build.md TECHNICAL
# BASELINE 3. User-facing times render in the branch timezone -- default Asia/Taipei
# -- at the DISPLAY layer only, never in storage. See UPSTREAM.md UP-009.
# The MySQL connection is pinned to the matching +00:00 in config/database.php.
TIMEZONE=UTC

FILESYSTEM_DRIVER=local

AWS_KEY=
AWS_SECRET=
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=


GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

MIX_AWS_ACCESS_KEY=
MIX_AWS_SECRET_KEY=
MIX_AWS_ARN_URL=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_KEY=
TWILIO_SECRET=

DEBUG_BAR=true

KURENTO_VIDEO=http://localhost/video/
KURENTO_SERVER=http://localhost:3000/

ANALYTICS_VIEW_ID=
CACHE_TIME=84000
# APP_TIMEZONE is NOT read by this application -- config/app.php:71 reads TIMEZONE.
# The variable is removed rather than left set, because a dead variable that looks
# authoritative is a trap. Set the timezone at TIMEZONE= above. (UPSTREAM.md UP-009)
FIREBASE_CREDENTIALS=''
CACHE_TIME=84000
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CURRENCY=NGN
#stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=

# GCash (via PayMongo)
GCASH_PUBLIC_KEY=
GCASH_SECRET_KEY=
GCASH_CURRENCY=PHP

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="QUEUE_DRIVER" value="sync"/>
    <env name="MAIL_DRIVER" value="array"/>
    <!-- WP 0A item 5: DB_* connection values live in .env.testing (gitignored), not here.
             phpunit.xml is committed, and this file must never carry a real credential.
             APP_ENV=testing above makes Laravel auto-load .env.testing, which points at the
             disposable churchcms_test_disposable database (WP 0A gate 7). Runtime refusal
             checks live in App\Providers\DatabaseSafetyServiceProvider (build.md L515):
             it prints and asserts environment/driver/host/database before migrate:fresh,
             db:wipe, or migrate:reset are allowed to run. -->
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
